REMOTE_GATEWAY_HOST=127.0.0.1
REMOTE_GATEWAY_PORT=9000
REMOTE_GATEWAY_TOKEN=
DATABASE_PATH=./remote_gateway.db
CLAUDE_CODE_ENABLED=true
CLAUDE_CODE_TIMEOUT_SECONDS=600
# Comma-separated list of root directories claude-code/gemini/codex sessions
# may use as working_directory. Empty = unrestricted (any existing path is allowed).
ALLOWED_WORKING_DIRECTORIES=
# Requires the `gemini` CLI (npm i -g @google/gemini-cli) authenticated via
# GEMINI_API_KEY or OAuth. Disabled by default since it needs its own setup.
GEMINI_ENABLED=false
GEMINI_TIMEOUT_SECONDS=600
# Requires the `codex` CLI (npm i -g @openai/codex) authenticated via
# `codex login` or an API key. Disabled by default since it needs its own setup.
CODEX_ENABLED=false
CODEX_TIMEOUT_SECONDS=600
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://localhost:1234/v1
VLLM_ENABLED=false
VLLM_BASE_URL=http://localhost:8000/v1
LOCALAI_ENABLED=false
LOCALAI_BASE_URL=http://localhost:8080/v1
SESSION_TIMEOUT_MINUTES=30
# A session inactive longer than SESSION_TIMEOUT_MINUTES is marked "expired"
# (swept every 60s) and refuses new messages — create a new session instead.
MAX_CONCURRENT_SESSIONS=10
ALLOW_MULTIPLE_SESSIONS_SAME_DRIVER=false
# Optional client identity for audit log entries — set X-Client-Id on requests
# to attribute usage; entries without it are logged as "anonymous".
# Query recorded usage with GET /logs. Operational stats (sessions_active,
# avg_latency_ms, ...) are at GET /metrics.
# Per-client_id (X-Client-Id) limit on POST /v1/messages, /sessions, and
# /sessions/{id}/messages — 0 disables it. Counts every attempt, including
# ones the endpoint itself later rejects for other reasons (409/429/etc).
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
LOG_FORMAT=console
# LOG_FORMAT=json for one JSON object per line (log shipping / SIEM ingestion)
